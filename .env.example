# ==============================================================================
# NutriCore Production Environment Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT:
# - Copy this file to '.env' for local development with your actual values.
# - NEVER commit the real '.env' file or production credentials to Git.
# - For Vercel deployment, configure these keys in Vercel Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Backend Settings (Vercel Serverless Function Environment)
# ------------------------------------------------------------------------------
# Production Secret Key (generate a strong random string)
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-secret-key-at-least-50-chars

# Set to False in Production
DEBUG=False

# Comma-separated list of allowed hostnames (include your Vercel domains)
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Database Settings (Backend Environment)
# ------------------------------------------------------------------------------
# Production Supabase PostgreSQL Connection String
# Use Supabase Transaction Pooler (Port 6543) for serverless deployments:
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# Database Connection Lifetime (Set to 0 for Serverless / Transaction Pooler mode)
DB_CONN_MAX_AGE=0

# ------------------------------------------------------------------------------
# 3. Supabase Storage Configuration (Backend Environment)
# ------------------------------------------------------------------------------
# Supabase project URL and keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=nutricore-media

# ------------------------------------------------------------------------------
# 4. CORS & CSRF Security Settings (Backend Environment)
# ------------------------------------------------------------------------------
# Comma-separated origins allowed for CORS (include frontend domains)
CORS_ALLOWED_ORIGINS=https://nutricore.vercel.app,http://localhost:5173

# Comma-separated trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=https://nutricore.vercel.app,https://*.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Production Cookie & JWT Settings (Backend Environment)
# ------------------------------------------------------------------------------
# Refresh token cookie security:
# - 'Lax' for Unified Domain deployments (frontend & backend on same origin)
# - 'None' for Cross-Origin deployments (separate frontend and API domains)
REFRESH_COOKIE_SAMESITE=Lax

# Cookie Secure flag (Must be True in HTTPS production environments)
REFRESH_COOKIE_SECURE=True

# ------------------------------------------------------------------------------
# 6. React Frontend Settings (Vite Environment — Publicly Exposed to Browser)
# ------------------------------------------------------------------------------
# CRITICAL: Variables prefixed with 'VITE_' are bundled into client-side JavaScript.
# NEVER put secrets, passwords, or service-role keys in VITE_ variables!
#
# For Unified-Domain Deployment (same Vercel project), leave default relative path:
VITE_API_BASE_URL=/api/v1
#
# For Split-Domain Deployment (separate API project), specify full API origin:
# VITE_API_BASE_URL=https://your-backend-api.vercel.app/api/v1
